    </div>
</div>
@section scripts {
    <!-- jQuery (مهم جدًا) -->
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

    <script>
        function loadSection(section) {
            let menu = document.getElementById('menuList');
            let urlMap = {
                'users': menu.dataset.usersUrl,
                'reports': menu.dataset.reportsUrl,
                'departments': menu.dataset.departmentsUrl,
                'faculty': menu.dataset.facultyUrl,
                'studyleaves': menu.dataset.studyleavesUrl // ✅ جديد: رابط الإجازات الدراسية
            };

            let url = urlMap[section];

            if (url) {
                $("#dashboardContent").html('<div class="text-center p-4"><div class="spinner-border text-info"></div></div>');
                $.get(url, function (data) {
                    $("#dashboardContent").html(data);
                });
            }
        }

    </script>
    <script>
        function setActive(el) {
            // إزالة الـ active من كل العناصر
            document.querySelectorAll('#reportsList .menu-item').forEach(item => {
                item.classList.remove('active');
            });
            // إضافة الـ active للعنصر المحدد
            el.classList.add('active');
        }
    </script>

}

