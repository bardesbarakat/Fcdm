@model IEnumerable<cdm.Models.ScientificMission>
@using cdm.Helpers

@{
    ViewBag.Title = "قائمة المهمات العلمية";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@{
    var encryptedId = EncryptionHelper.Encrypt("1"); // استبدل 1 بـ Model.DepartmentID لو متاح
}

<div class="container py-4">
    <div class="bg-light p-4 rounded shadow-sm mb-4">
        <div class="d-flex justify-content-between align-items-center flex-wrap pb-2">
            <h4 class="mb-3 text-primary">
                <i class="bi bi-list-task"></i> قائمة المهمات العلمية
            </h4>
            <a href="@Url.Action("InsertData", "ScientificMissions", new { encryptedId = encryptedId })" class="btn btn-success mb-3">
                <i class="bi bi-plus-circle-fill"></i> إضافة مهمة جديدة
            </a>
        </div>

        @using (Html.BeginForm("Index", "ScientificMissions", FormMethod.Get, new { @class = "row g-2" }))
        {
            <div class="col-md-5">
                @Html.TextBox("FacultyName", Request["FacultyName"], new { @class = "form-control", placeholder = "ابحث باسم العضو..." })
            </div>
            <div class="col-md-3">
                <button type="submit" class="btn btn-primary w-100">
                    <i class="bi bi-search"></i> بحث
                </button>
            </div>
            <div class="col-md-3">
                <a href="@Url.Action("Index", "ScientificMissions")" class="btn btn-outline-secondary w-100">
                    <i class="bi bi-x-circle"></i> مسح الفلاتر
                </a>
            </div>
        }
    </div>
</div>


<div class="table-responsive">
    <table class="table table-hover table-bordered text-center align-middle bg-white shadow-sm">
        <thead class="table-primary">
            <tr>
                <th>#</th>
                <th>الاسم</th>
                <th>الدولة</th>
                <th>نوع المهمة</th>
                <th>تاريخ السفر</th>
                <th>نوع الإجازة</th>
                <th>الإجراءات</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.Any())
            {
                int counter = 1;
                foreach (var item in Model)
                {
                    <tr>
                        <td>@counter</td>
                        <td>@item.FacultyMember.FullName</td>
                        <td>@item.Country</td>
                        <td>@item.MissionType</td>
                        <td>@(item.TravelDate?.ToString("yyyy-MM-dd") ?? "—")</td>
                        <td>@item.LeaveType</td>
                        <td>
                            <div class="d-flex flex-wrap gap-1 justify-content-center">
                                <a href="@Url.Action("Details", "ScientificMissions", new { id = item.MissionID })" class="btn btn-sm btn-outline-primary">
                                    <i class="bi bi-eye"></i> عرض
                                </a>
                                <a href="@Url.Action("Edit", "ScientificMissions", new { id = item.MissionID })" class="btn btn-sm btn-outline-warning">
                                    <i class="bi bi-pencil-square"></i> تعديل
                                </a>
                                <a href="@Url.Action("Delete", "ScientificMissions", new { id = item.MissionID })" class="btn btn-sm btn-outline-danger">
                                    <i class="bi bi-trash"></i> حذف
                                </a>
                            </div>
                        </td>
                    </tr>
                    counter++;
                }
            }
            else
            {
                <tr>
                    <td colspan="7" class="text-danger">لا توجد مهمات علمية مسجلة</td>
                </tr>
            }
        </tbody>
    </table>
</div>
    </div>
