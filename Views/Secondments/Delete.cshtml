@model cdm.Models.SecondmentsData

@{
    ViewBag.Title = "تأكيد حذف الإعارة";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-5">
    <div class="alert alert-warning shadow-sm">
        <h4><i class="bi bi-exclamation-triangle"></i> تأكيد الحذف</h4>
        <p>هل أنت متأكد أنك تريد حذف الإعارة الخاصة بـ <strong>@Model.FacultyMember.FullName</strong>؟</p>

        @using (Html.BeginForm("Delete", "Secondments", FormMethod.Post))
        {
            @Html.AntiForgeryToken()
            @Html.HiddenFor(m => m.ID)

            <button type="submit" class="btn btn-danger">تأكيد الحذف</button>
            <a href="@Url.Action("Index")" class="btn btn-secondary">إلغاء</a>
        }
    </div>
</div>
