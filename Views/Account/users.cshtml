@model cdm.Models.AdminDashboardViewModel
@{
    ViewBag.Title = "users";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2>لوحة الإدارة</h2>

<div class="row">
    <div class="col-md-6">
        <h3>المستخدمون</h3>
        <table class="table table-bordered">
            <thead>
                <tr>
                    <th>الاسم</th>
                    <th>اسم المستخدم</th>
                    <th>البريد</th>
                    <th>الدور</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var user in Model.Users)
                {
                    <tr>
                        <td>@user.FullName</td>
                        <td>@user.Username</td>
                        <td>@user.Email</td>
                        <td>@user.Role?.RoleName</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div class="col-md-6">
        <h3>التقارير</h3>
        <ul class="list-group">
            @foreach (var report in Model.Reports)
            {
                <li class="list-group-item">@report</li>
            }
        </ul>
    </div>
</div>



