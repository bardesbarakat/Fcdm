@{
    ViewBag.Title = "Login";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" rel="stylesheet" />



    <style>
        .login-card {
            background: #ffffff;
            padding: 2.5rem 2rem;
            border-radius: 1rem;
            box-shadow: 0 12px 40px rgba(0, 0, 0, 0.15);
            width: 100%;
            max-width: 420px;
            animation: fadeIn 0.5s ease-in-out;
        }

        .login-heading {
            font-weight: bold;
            font-size: 1.8rem;
            color: #c99336;
        }

        .form-label i {
            margin-left: 8px;
            color: #c99336;
        }

        .btn-login {
            background: linear-gradient(to right, #ffc766, #c99336);
            border: none;
            font-weight: 600;
        }

            .btn-login:hover {
                background: linear-gradient(to right, #ffc766, #c99336);
            }

        .form-control:focus {
            border-color: #0072ff;
            box-shadow: 0 0 0 0.2rem rgba(0, 114, 255, 0.25);
        }

        @@keyframes fadeIn {
            from {
                opacity: 0;
                transform: translateY(30px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }
    </style>
    <div class="contact mt-5">
        
        <section class="d-flex align-items-center justify-content-center" style="min-height: 80vh;">
            <div class="login-card">
                <h2 class="text-center login-heading mb-4">
                    <i class="bi bi-box-arrow-in-right me-2"></i>
                    تسجيل الدخول
                </h2>

                @if (!string.IsNullOrEmpty(ViewBag.Error as string))

                {
                    <div class="alert alert-danger text-center">@ViewBag.Error</div>
                }

                @using (Html.BeginForm("Login", "Account", FormMethod.Post, new { autocomplete = "off" }))
                {
                    @Html.AntiForgeryToken()

                    <div class="form-group mb-3">
                        <label class="form-label"><i class="bi bi-person-fill"></i> اسم المستخدم</label>
                        @Html.TextBox("username", null, new { @class = "form-control", placeholder = "ادخل اسم المستخدم", required = "required", autocomplete = "off" })
                    </div>

                    <div class="form-group mb-4">
                        <label class="form-label"><i class="bi bi-shield-lock-fill"></i> كلمة المرور</label>
                        @Html.Password("password", null, new { @class = "form-control", placeholder = "ادخل كلمة المرور", required = "required", autocomplete = "new-password" })
                    </div>

                    <button type="submit" class="btn btn-login w-100 py-2">تسجيل الدخول</button>
                }

                <div class="text-center mt-4">
                    <small class="text-muted">ليس لديك حساب؟</small>
                    <br />
                    <a href="@Url.Action("Register", "Account")" class="text-decoration-none fw-bold text-primary">
                        <i class="bi bi-person-plus-fill me-1"></i> سجّل الآن
                    </a>
                </div>
            </div>
        </section>
        </div>
