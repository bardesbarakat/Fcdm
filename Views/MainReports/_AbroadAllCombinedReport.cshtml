@model List<cdm.Models.AbroadFacultyReportVM>
@{
    var year = ViewBag.AcademicYear;
    var college = ViewBag.College;
    int counter = 1;
}
<div id="printArea">
    <div class="text-center mb-4">
        <h5 class="fw-bold text-decoration-underline">
            بيـــــــــــــان بالســــــــــــادة أعضــــــــــــــــاء هيئــــــــــــــــة التــــــــــدريــــــــــــــــــس<br />
            <span class="fw-normal">(الإعارات - المهمات العلمية - الإجازات الدراسية)</span>
        </h5>
        <p>للخارج للعـــــــــــــــــــام <strong>@year</strong></p>
        <p>كليــــــــــــــــــــــة: <strong>@college</strong> - جامعة الفيوم</p>
    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-warning text-center">لا توجد بيانات</div>
    }
    else
    {
        <table class="table table-bordered text-center" dir="rtl">
            <thead class="table-success">
                <tr>
                    <th>م</th>
                    <th>الاسم</th>
                    <th>الوظيفة</th>
                    <th>جهة عمله بالجامعة<br />(الكلية)</th>
                    <th>الرقم القومي</th>
                    <th>التخصص</th>
                    <th>الدولة</th>
                    <th>نوع العمل</th>
                    <th>تاريخ العمل بالخارج</th>
                    <th>تاريخ العودة</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@counter</td>
                        <td>@item.FullName</td>
                        <td>@item.JobTitle</td>
                        <td>@item.CollegeName</td>
                        <td>@item.NationalID</td>
                        <td>@item.Specialization</td>
                        <td>@item.Country</td>
                        <td>@item.WorkType</td>
                        <td>@(item.TravelDate?.ToString("yyyy-MM-dd") ?? "-")</td>
                        <td>@(item.ReturnDate?.ToString("yyyy-MM-dd") ?? "-")</td>
                    </tr>
                    counter++;
                }
            </tbody>
        </table>
    }

    <!-- توقيع مدير المكتب -->
    <div class="mt-5 px-4 d-print-block" style="text-align:left">
        <p><strong class="px-5">توقيع المدير </strong> <br />_______________________</p>
    </div>
</div>

<div class="text-end mt-4 d-print-none">
    <button class="btn btn-outline-primary" onclick="printReport()">
        🖨️ طباعة التقرير
    </button>
</div>

<script>
    function printReport() {
        const content = document.getElementById("printArea")?.innerHTML || document.body.innerHTML;
        const printWindow = window.open('', '', 'width=1000,height=800');
        printWindow.document.write(`
            <html>
                <head>
                    <title>تقرير أعضاء هيئة التدريس بالخارج</title>
                    <style>
                        body { direction: rtl; font-family: "Segoe UI", Tahoma, sans-serif; padding: 20px; }
                        table, th, td { border: 1px solid black; border-collapse: collapse; padding: 6px; }
                        thead { background-color: #d1e7dd; color: #0f5132; }
                        h5 { text-decoration: underline; margin-bottom: 20px; }
                        .text-end { text-align: right; }
                        .text-center { text-align: center; }
                        .mt-5 { margin-top: 3rem; }
                    </style>
                </head>
                <body onload="window.print(); window.close();">
                    ${content}
                </body>
            </html>
        `);
        printWindow.document.close();
    }
</script>
