@{
    var colleges = ViewBag.Colleges as List<SelectListItem>;
}

<div class="row">
    <div class="col-md-4">
        <label for="collegeId" class="form-label">الكلية</label>
        @Html.DropDownList("collegeId", colleges, "-- اختر الكلية --", new { @class = "form-control" })
    </div>

    <div class="col-md-4">
        <label for="academicYearStart" class="form-label">بداية العام الجامعي</label>
        <input type="number" name="academicYearStart" class="form-control" placeholder="مثال: 2024" />
    </div>

    <div class="col-md-4">
        <label for="academicYearEnd" class="form-label">نهاية العام الجامعي</label>
        <input type="number" name="academicYearEnd" class="form-control" placeholder="مثال: 2025" />
    </div>
</div>

