
@model List<cdm.Models.FacultyLeaveStatusReportVM>

@{
    var college = ViewBag.College ?? "جميع الكليات";
    int counter = 1;
}

<div id="printArea">
    <div class="text-center mb-4">
        <h5 class="fw-bold text-decoration-underline">
            بيان بيانات السادة أعضاء هيئة التدريس <br />
            <span class="fw-normal">(إجازات دراسية – مهمات علمية – منح – بعثات – إجازات تفرغ)</span>
        </h5>
        <p>بالخارج والداخل</p>
        <p>الكلية: <strong>@college</strong></p>
    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-warning text-center">لا توجد بيانات</div>
    }
    else
    {
        <table class="table table-bordered text-center" dir="rtl">
            <thead class="table-success">
                <tr>
                    <th>م</th>
                    <th>الكلية</th>
                    <th>الاسم</th>
                    <th>الوظيفة</th>
                    <th>القسم</th>
                    <th>البلد</th>
                    <th>نوع الإفاد</th>
                    <th>العام الحالى في الإجازة</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@counter</td>
                        <td>@item.CollegeName</td>
                        <td>@item.FullName</td>
                        <td>@item.JobTitle</td>
                        <td>@item.DepartmentName</td>
                        <td>@item.Country</td>
                        <td>@item.LeaveType</td>
                        <td>@item.CurrentLeaveYear</td>
                    </tr>
                    counter++;
                }
            </tbody>
        </table>
    }

    <!-- التوقيع والطباعة -->
    <div class="mt-5 pt-5 d-print-block">
        <div class="mt-5 pt-4 d-print-block">
            <div class="mt-5 px-4 d-print-block" style="text-align:left">
                <p><strong class="px-5">توقيع المدير </strong> <br />_______________________</p>
            </div>

        </div>

        <div class="text-end mt-4">
            <p><strong>تاريخ الطباعة:</strong> @DateTime.Now.ToString("yyyy-MM-dd")</p>
        </div>
    </div>
</div>

<div class="text-end mt-4 d-print-none">
    <button class="btn btn-outline-primary" onclick="printReport()">
        🖨️ طباعة التقرير
    </button>
</div>

<script>
    function printReport() {
        const content = document.getElementById("printArea").innerHTML;
        const printWindow = window.open('', '', 'width=1000,height=800');
        printWindow.document.write(`
            <html>
                <head>
                    <title>تقرير الإجازات والبعثات</title>
                    <style>
                        body { direction: rtl; font-family: "Segoe UI", Tahoma, sans-serif; padding: 20px; }
                        table, th, td { border: 1px solid black; border-collapse: collapse; padding: 6px; }
                        thead { background-color: #d1e7dd; color: #0f5132; }
                        h5 { text-decoration: underline; margin-bottom: 20px; }
                        .text-end { text-align: right; }
                        .text-center { text-align: center; }
                    </style>
                </head>
                <body onload="window.print(); window.close();">
                    ${content}
                </body>
            </html>
        `);
        printWindow.document.close();
    }
</script>
