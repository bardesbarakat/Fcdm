@model IEnumerable<cdm.Models.VisitingProfessor>

@{
    ViewBag.Title = "قائمة الأساتذة الزائرين";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container py-4">
    <div class="bg-light p-4 rounded shadow-sm mb-4">
        <div class="d-flex justify-content-between align-items-center flex-wrap pb-2">
            <h4 class="mb-3 text-primary">
                <i class="bi bi-person-lines-fill"></i> قائمة الأساتذة الزائرين
            </h4>
            <a href="@Url.Action("InsertData", "VisitingProfessors")" class="btn btn-success mb-3">
                <i class="bi bi-plus-circle-fill"></i> إضافة أستاذ زائر
            </a>
        </div>

        @using (Html.BeginForm("Index", "VisitingProfessors", FormMethod.Get, new { @class = "row g-2 pt-1" }))
        {
            <div class="col-md-5">
                @Html.TextBox("FacultyName", Request["FacultyName"], new { @class = "form-control", placeholder = "ابحث باسم العضو..." })
            </div>
            <div class="col-md-3">
                <button type="submit" class="btn btn-primary w-100">
                    <i class="bi bi-search"></i> بحث
                </button>
            </div>
            <div class="col-md-3">
                <a href="@Url.Action("Index", "VisitingProfessors")" class="btn btn-outline-secondary w-100">
                    <i class="bi bi-x-circle"></i> مسح الفلاتر
                </a>
            </div>
        }
    </div>

    @if (ViewBag.Message != null)
    {
        <div class="alert alert-success text-center shadow-sm">
            <strong>@ViewBag.Message</strong>
        </div>
    }
</div>

<div class="table-responsive">
    <table class="table table-hover table-bordered text-center align-middle bg-white shadow-sm">
        <thead class="table-primary">
            <tr>
                <th>#</th>
                <th>الاسم</th>
                <th>نوع الزيارة</th>
                <th>الدولة</th>
                <th>من</th>
                <th>إلى</th>
                <th>الجامعة الزائرة</th>
                <th>الإجراءات</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.Any())
            {
                int counter = 1;
                foreach (var item in Model)
                {
                    <tr>
                        <td>@counter</td>
                        <td>@item.FacultyMember.FullName</td>
                        <td>@item.VisitType</td>
                        <td>@item.Country</td>
                        <td>@(item.VisitStartDate?.ToString("yyyy-MM-dd") ?? "—")</td>
                        <td>@(item.VisitEndDate?.ToString("yyyy-MM-dd") ?? "—")</td>
                        <td>@item.VisitorUniversityName</td>
                        <td>
                            <div class="d-flex flex-wrap gap-1 justify-content-center">
                                <a href="@Url.Action("Details", "VisitingProfessors", new { id = item.Id })" class="btn btn-sm btn-outline-primary">
                                    <i class="bi bi-eye"></i> عرض
                                </a>
                                <a href="@Url.Action("Edit", "VisitingProfessors", new { id = item.Id })" class="btn btn-sm btn-outline-warning">
                                    <i class="bi bi-pencil-square"></i> تعديل
                                </a>
                                <a href="@Url.Action("Delete", "VisitingProfessors", new { id = item.Id })" class="btn btn-sm btn-outline-danger">
                                    <i class="bi bi-trash"></i> حذف
                                </a>
                            </div>
                        </td>
                    </tr>
                    counter++;
                }
            }
            else
            {
                <tr>
                    <td colspan="8" class="text-danger">لا توجد زيارات مسجلة</td>
                </tr>
            }
        </tbody>
    </table>
</div>
