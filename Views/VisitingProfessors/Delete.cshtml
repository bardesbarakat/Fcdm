@model cdm.Models.VisitingProfessor

@{
    ViewBag.Title = "حذف أستاذ زائر";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-4">
    <div class="alert alert-warning text-center shadow-sm p-4">
        <h4>⚠️ هل أنت متأكد أنك تريد حذف هذا الأستاذ الزائر؟</h4>
        <p class="mt-3"><strong>@Model.FacultyMember.FullName</strong></p>
    </div>

    @using (Html.BeginForm("Delete", "VisitingProfessors", FormMethod.Post))
    {
        @Html.AntiForgeryToken()
        @Html.HiddenFor(model => model.Id)

        <div class="text-center mt-4">
            <button type="submit" class="btn btn-danger me-2">
                <i class="bi bi-trash-fill"></i> تأكيد الحذف
            </button>
            <a href="@Url.Action("Index")" class="btn btn-secondary">
                <i class="bi bi-x-circle"></i> إلغاء
            </a>
        </div>
    }
</div>
