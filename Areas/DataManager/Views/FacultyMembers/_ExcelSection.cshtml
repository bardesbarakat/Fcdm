@inherits System.Web.Mvc.WebViewPage<cdm.Areas.DataManager.Models.FacultyExcelUploadVM>
@{
    ViewBag.Title = "رقع ملف الاكسل";
    Layout = "~/Areas/DataManager/Views/Shared/_LayoutDataManager.cshtml";
}

<h4>📚 رقع ملف الاكسل</h4>

<div class="card">
    <div class="card-body">
        <h6 class="card-title">📂 رفع بيانات أعضاء هيئة التدريس من ملف Excel</h6>
        <p>
            <a class="btn btn-outline-success" href="@Url.Action("DownloadTemplate","FacultyMembers", new { area="DataManager"})">تحميل التمبليت</a>
        </p>
        @using (Html.BeginForm("ImportExcel", "FacultyMembers", FormMethod.Post, new { area = "DataManager", enctype = "multipart/form-data" }))
        {
            @Html.AntiForgeryToken()
            <div class="row g-2">
                <div class="col-md-8"><input type="file" name="file" accept=".xlsx" class="form-control" required /></div>
                <div class="col-md-4 d-flex align-items-end"><button class="btn btn-primary w-100">رفع الملف</button></div>
            </div>
        }
    </div>
</div>
